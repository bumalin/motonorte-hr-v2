# Copy to .env and replace every value. Never commit .env.
# Passwords: letters and digits ONLY (they go inside connection URLs). Generate with: openssl rand -hex 24

# Postgres container (docker-compose.yml)
POSTGRES_DB=motonorte
POSTGRES_USER=app_owner
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app

# Owner connection: migrations, seed, create-user only
DATABASE_URL_OWNER=postgres://app_owner:change-me-owner@127.0.0.1:5434/motonorte
# App connection: non-owner role, RLS applies
DATABASE_URL=postgres://app_user:change-me-app@127.0.0.1:5434/motonorte

# prod profile (web server OR office PC) — see docs/runbook.md / docs/runbook-office.md
#   Web server:  DOMAIN=payroll.yourdomain.com   CADDYFILE=Caddyfile
#   Office PC:   DOMAIN=192.168.50.241 (this PC's fixed LAN IP)   CADDYFILE=Caddyfile.office
DOMAIN=
CADDYFILE=Caddyfile
TRUST_PROXY=0                 # 1 when running behind Caddy (prod profile)
DB_PORT=5434                  # host-only Postgres port; use a different one if another copy already uses 5434
# Encrypted off-machine backups: public key from `age-keygen` (private key kept offline), and the folder that syncs off-site
AGE_RECIPIENT=
OFFSITE_DIR=./offsite
BACKUP_SCHEDULE="0 23 * * *"  # office PC: "45 17 * * *" (the PC must be on at that time)
# Office PC only: COMPOSE_PROJECT_NAME=motonorte-office (see docs/runbook-office.md). Never motonorte-payroll (the dev/test copy).

# Optional (US-051)
OPENAI_API_KEY=
OPENAI_MODEL=
